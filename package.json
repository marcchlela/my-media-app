{
  "name": "my-media-app",
  "version": "0.3.1",
  "description": "Desktop and web media library app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "User",
  "license": "ISC",
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ffprobe-static": "^3.1.0",
    "hls.js": "^1.6.13"
  },
  "build": {
    "appId": "com.mymediaapp.desktop",
    "productName": "My Media App",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffprobe-static/bin/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "account-store.js",
      "env-config.js",
      "index.html",
      "main.js",
      "media-utils.js",
      "myflix-cinema-designs-v2/**/*",
      "myflix-electric/**/*",
      "!myflix-electric/assets/generated-3d/sources/**/*",
      "!myflix-electric/assets/generated-3d/*.png",
      "package.json",
      "preload.js",
      "renderer.js",
      "style.css"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "My Media App"
    }
  }
}
