# Server process
NODE_ENV=production
PORT=3000
DATA_DIR=/data
MOVIES_DIR=/media/Movies
TV_SHOWS_DIR=/media/TV Shows

# Optional metadata enrichment. Never commit a real key.
TMDB_API_KEY=

# Comma-separated accounts that become administrators after signup/login.
ADMIN_EMAILS=you@example.com

# Anonymous browsing/streaming remains available when REQUIRE_AUTH=false.
ALLOW_SIGNUP=true
REQUIRE_AUTH=false
SCAN_ON_STARTUP=true

# Same-origin clients need no entry. Add comma-separated full origins only
# when a separate trusted frontend must call this server.
ALLOWED_ORIGINS=

# Enable only behind HTTPS. TRUST_PROXY is for a trusted reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

# Keep arbitrary path routes disabled in normal server mode.
ENABLE_LEGACY_PATH_ROUTES=false

# Electron server mode only. Use the permanent MyFlix server URL.
SHARED_SERVER_URL=http://192.168.1.115:3000
